# =============================================================================
# HBS — environment template
# Copy to `.env.local` (development) or `.env.production.local` (production).
# `.env*` is git-ignored, so secrets here are NEVER committed.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon / public key. Safe in the browser ONLY because Row Level Security
# (supabase/migrations/0001_rls_policies.sql) restricts anonymous access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Cookie signing secret (required in production) --------------------------
# Used by lib/security.ts to sign session cookies (hbs-user-role / hbs-user-email).
# MUST be >= 16 chars and UNIQUE. Do NOT reuse the Supabase anon key.
# In production, if this is missing the app refuses to sign cookies.
NEXT_PUBLIC_COOKIE_SECRET=change-me-to-a-long-random-string-min-16-chars
# Demo login (OZGUR/OZDEMIR etc.). Set "true" ONLY in development.
# Leave unset / "false" in production so demo accounts are disabled.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# --- Optional runtime overrides ----------------------------------------------
# Server-only secret used for server-side session issuance (recommended).
# If set, prefer this over NEXT_PUBLIC_COOKIE_SECRET for any server-side signing.
# COOKIE_SECRET=server-only-secret-min-32-chars
